[submodule "ggml"]
    path = ggml
	# GluRun: leejet/ggml with our commits, kept as the branch glurun/ggml of this same
	# repository (see .glurun-base). One clone therefore carries both trees.
	url = https://github.com/GluLabs-ai/stable-diffusion.cpp.git
	branch = glurun/ggml
[submodule "examples/server/frontend"]
	path = examples/server/frontend
	url = https://github.com/leejet/sdcpp-webui.git
[submodule "thirdparty/libwebp"]
	path = thirdparty/libwebp
	url = https://github.com/webmproject/libwebp.git
[submodule "thirdparty/libwebm"]
	path = thirdparty/libwebm
	url = https://github.com/webmproject/libwebm.git
