#version 450
// GluRun: register-tiled Q2_0 x f32 matmul for Adreno (kernels/README.md, "Register-tiled kernel").
//
// Why not mul_mm.comp: on the Adreno 740 driver (512.676) that shader tops out at ~45 GFLOPS with
// its tiles as specialisation constants and ~87 GFLOPS with them hard-coded, whatever the tile,
// and the harness bisection (EXPERIMENT bits) showed the loads and the dequant are ~2.5% of the
// time: the shared-memory inner loop is the limit. This kernel has no shared memory and no
// specialisation constants. Each thread owns a TM x TN block of D, streams A through the 16-bit
// packed view (8 two-bit weights per load) and B as vec4, and accumulates each 64-wide Q2_0
// block in registers before applying the block scale.
//
// Interface: identical to matmul_quant_f32 (bindings A/B/D, vk_mat_mat_push_constants, workgroup
// grid {ceil(M/BM), ceil(N/BN), batches} with split-k in x). K is a multiple of 64 (Q2_0 block)
// and stride_b a multiple of 4 (B contiguous), which is what ggml guarantees on this path.

#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

#ifndef TM
#define TM 4
#endif
#ifndef TN
#define TN 4
#endif
#define BM (8 * TM)     // 64 threads = 8 (m) x 8 (n)
#define BN (8 * TN)

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct block_q2_0_packed16 {
    float16_t d;
    uint16_t qs[8];
};

layout (binding = 0) readonly buffer A  { block_q2_0_packed16 data_a[]; };
layout (binding = 1) readonly buffer B4 { vec4 data_b4[]; };
layout (binding = 2) writeonly buffer D { float data_d[]; };

layout (push_constant) uniform parameter
{
    uint M;
    uint N;
    uint K;
    uint stride_a;
    uint stride_b;
    uint stride_d;
    uint batch_stride_a;
    uint batch_stride_b;
    uint batch_stride_d;
    uint base_work_group_z;
    uint num_batches;
    uint k_split;
    uint ne02;
    uint ne12;
    uint broadcast2;
    uint broadcast3;
} p;

void main() {
    const uint batch_idx = gl_WorkGroupID.z + p.base_work_group_z;
    const uint i13 = batch_idx / p.ne12;
    const uint i12 = batch_idx % p.ne12;
    const uint i03 = i13 / p.broadcast3;
    const uint i02 = i12 / p.broadcast2;
    const uint batch_idx_a = i03 * p.ne02 + i02;

    const uint blocks_m = (p.M + BM - 1) / BM;
    const uint ir = gl_WorkGroupID.x % blocks_m;
    const uint ik = gl_WorkGroupID.x / blocks_m;
    const uint ic = gl_WorkGroupID.y;

    const uint start_k = ik * p.k_split;
    const uint end_k = min(p.K, (ik + 1) * p.k_split);

    const uint lid = gl_LocalInvocationID.x;
    const uint row0 = ir * BM + (lid % 8u) * TM;
    const uint col0 = ic * BN + (lid / 8u) * TN;

    // Loads are clamped into the matrix (rows/cols past the edge read the last one), stores are guarded.
    uint ablk[TM];
    [[unroll]] for (uint i = 0; i < TM; i++) {
        const uint row = min(row0 + i, p.M - 1u);
        ablk[i] = (batch_idx_a * p.batch_stride_a + row * p.stride_a + start_k) / 64u;
    }
    uint bvec[TN];
    [[unroll]] for (uint j = 0; j < TN; j++) {
        const uint col = min(col0 + j, p.N - 1u);
        bvec[j] = (batch_idx * p.batch_stride_b + col * p.stride_b + start_k) / 4u;
    }

    float acc[TM][TN];
    [[unroll]] for (uint i = 0; i < TM; i++) {
        [[unroll]] for (uint j = 0; j < TN; j++) {
            acc[i][j] = 0.0f;
        }
    }

    for (uint kb = start_k; kb < end_k; kb += 64u) {
        float blk[TM][TN];
        [[unroll]] for (uint i = 0; i < TM; i++) {
            [[unroll]] for (uint j = 0; j < TN; j++) {
                blk[i][j] = 0.0f;
            }
        }
        // not unrolled: with the q loop unrolled too, glslc -O overflows its stack (exit 0xC00000FD)
        [[dont_unroll]] for (uint q = 0; q < 8; q++) {         // 8 weights (k = kb + 8q .. +7) per 16-bit word
            uint w[TM];
            [[unroll]] for (uint i = 0; i < TM; i++) {
                w[i] = uint(data_a[ablk[i]].qs[q]);
            }
            [[unroll]] for (uint h = 0; h < 2; h++) {          // two vec4 of B per word
                vec4 b[TN];
                [[unroll]] for (uint j = 0; j < TN; j++) {
                    b[j] = data_b4[bvec[j] + 2u * q + h];
                }
                [[unroll]] for (uint e = 0; e < 4; e++) {
                    const uint sh = 2u * (4u * h + e);
                    [[unroll]] for (uint i = 0; i < TM; i++) {
                        const float a = float((w[i] >> sh) & 3u) - 1.0f;
                        [[unroll]] for (uint j = 0; j < TN; j++) {
                            blk[i][j] = fma(a, b[j][e], blk[i][j]);
                        }
                    }
                }
            }
        }
        [[unroll]] for (uint i = 0; i < TM; i++) {
            const float d = float(data_a[ablk[i]].d);
            [[unroll]] for (uint j = 0; j < TN; j++) {
                acc[i][j] = fma(d, blk[i][j], acc[i][j]);
            }
            ablk[i] += 1u;
        }
        [[unroll]] for (uint j = 0; j < TN; j++) {
            bvec[j] += 16u;
        }
    }

    const uint offsets = batch_idx * p.batch_stride_d + ik * p.batch_stride_d * p.num_batches;
    [[unroll]] for (uint j = 0; j < TN; j++) {
        if (col0 + j < p.N) {
            [[unroll]] for (uint i = 0; i < TM; i++) {
                if (row0 + i < p.M) {
                    data_d[offsets + (col0 + j) * p.stride_d + row0 + i] = acc[i][j];
                }
            }
        }
    }
}
